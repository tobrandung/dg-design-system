{
  "font-family": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Sohne",
      "$description": "Grundschrift für Fließtext, Labels und Überschriften.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "FONT_FAMILY"
          ],
          "codeSyntax": {
            "WEB": "var(--dg-font-family-sans)"
          }
        }
      }
    },
    "display": {
      "$type": "fontFamily",
      "$value": "SohneDG Schmal",
      "$description": "Condensed-Schrift nur für H1 (Versalien).",
