{
  "name": "dg-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design Tokens und Komponenten-Prototyp. Quelle der Wahrheit sind die Figma-Variablen, Code wird daraus generiert.",
  "exports": {
    "./css": "./dist/css/index.css",
    "./css/*": "./dist/css/*",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.mjs"
    },
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:build && vite build",
    "preview": "vite preview",
    "tokens:build": "node scripts/build-tokens.mjs",
    "plugin:build": "node scripts/build-plugin.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1"
  },
  "devDependencies": {
    "style-dictionary": "5.8.0",
    "vite": "8.3.6"
  }
}
